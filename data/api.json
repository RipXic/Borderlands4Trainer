 "toggles": {
  "god": {
   "desc": "God mode (game's own god lock). Re-applied after map changes.",
   "on": {
    "action": "Player.GodOn"
   },
   "off": {
    "action": "Player.GodOff"
   }
  },
  "inf_ammo": {
   "desc": "Infinite ammo: the game's own InfiniteAmmoLock (kept on) + reserve refill twice a second",
   "on": {
    "action": "Weapon.InfiniteAmmo",
    "v": 1
   },
   "off": {
    "action": "Weapon.InfiniteAmmo",
    "v": 0
   },
   "tick": {
    "action": "Weapon.InfiniteAmmo",
    "v": 1
   },
   "every_ms": 500
  },
  "big_backpack": {
   "desc": "Backpack capacity kept at least at the chosen size (re-applied every 2 s and after loads; a bigger size from another mod is left alone)",
   "value": 60,
   "on": {
    "action": "Inventory.BackpackSize"
   },
   "tick": {
    "action": "Inventory.BackpackSize"
   },
   "every_ms": 2000
  },
  "big_bank": {
   "desc": "Bank capacity kept at least at the chosen size (a bigger size from another mod is left alone)",
   "value": 500,
   "on": {
    "action": "Inventory.BankSize"
   },
   "tick": {
    "action": "Inventory.BankSize"
   },
   "every_ms": 2000
  },
  "free_vault_power": {
   "desc": "Dash / double jump / glide cost nothing (kept every second)",
   "tick": {
    "action": "Move.FreeVaultPower"
   },
   "every_ms": 1000
  },
  "no_skill_cooldown": {
   "desc": "Action Skill always ready",
   "tick": {
    "action": "Skill.RefillCooldown"
   },
   "every_ms": 500
  },
  "invisible": {
   "desc": "Enemies ignore you (Team_FriendlyToAll). Re-applied after map changes.",
   "on": {
    "action": "Player.InvisibleOn"
   },
   "off": {
    "action": "Player.InvisibleOff"
   }
  },
  "instant_reload": {
   "desc": "Reloads finish almost at once (reload time 0.1 s). Off = the gun's normal reload time. Kept after map changes.",
   "on": {
    "cmd": "BL.ATTR",
    "args": {
     "name": "weapon_reload_time",
     "v": 0.1,
     "mode": "set"
    }
   },
   "off": {
    "cmd": "BL.ATTR",
    "args": {
     "name": "weapon_reload_time",
     "reset": true
    }
   }
  },
  "skill_endless": {
   "desc": "Action Skill never runs out while it is active (duration refilled twice a second)",
   "tick": {
    "action": "Skill.RefillDuration"
   },
   "every_ms": 500
  },
  "fast_cooldown": {
   "desc": "Action Skill cooldown runs faster: value = speed (4 = four times as fast). Refilled 4x a second with the game's own RefillCooldownByValue.",
   "value": 4,
   "tick": {
    "cmd": "BL.SKILL_CD_TICK"
   },
   "every_ms": 250
  },
  "infinite_jump": {
