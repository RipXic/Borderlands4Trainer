{
 "_about": "Trainer actions: every action calls the game's own function (by its reflected name) on a target object. The trainer re-reads this file within a second when it changes.",
 "readouts": {
  "position": {
   "target": "player.pawn",
   "func": "K2_GetActorLocation",
   "desc": "world position (cm)"
  },
  "god": {
   "target": "cdo:DamageStatics",
   "func": "IsInGodMode",
   "args": {
    "OwnerContext": "target:player.pawn"
   },
   "desc": "god mode active (game's own check)"
  },
  "level": {
   "target": "player.ps",
   "func": "BP_GetExperienceLevel",
   "args": {
    "ExperienceDef": "def:(\"Character\",\"GbxExperienceDef\")"
   },
   "desc": "character level"
  },
  "spec_level": {
   "target": "player.ps",
   "func": "BP_GetExperienceLevel",
   "args": {
    "ExperienceDef": "def:(\"Specialization\",\"GbxExperienceDef\")"
   },
   "desc": "specialization level"
  },
  "ground_speed_scale": {
   "attr": "ground_speed_scale",
   "desc": "ground speed multiplier"
  },
  "health": {
   "attr": "health_resource_current_value",
   "desc": "health"
  },
  "max_health": {
   "attr": "health_resource_max_value",
   "desc": "max health"
  },
  "shield": {
   "attr": "shield_resource_current_value",
   "desc": "shield"
  },
  "max_shield": {
   "attr": "shield_resource_max_value",
   "desc": "max shield"
  },
  "overshield": {
   "attr": "overshield_resource_current_value",
   "desc": "overshield"
  },
  "damage_mult": {
   "attr": "damage_dealt_multiplier",
   "desc": "damage dealt multiplier"
  },
  "damage_taken": {
   "attr": "damage_taken_multiplier",
   "desc": "damage taken multiplier"
  },
  "fire_rate": {
   "attr": "weapon_fire_rate",
   "desc": "weapon fire rate (shots/s)"
  },
  "reload_time": {
   "attr": "weapon_reload_time",
   "desc": "reload time (s)"
  },
  "weapon_damage": {
   "attr": "weapon_damage",
   "desc": "weapon damage per shot"
  },
  "loaded_ammo": {
   "attr": "weapon_loaded_ammo",
   "desc": "magazine"
  },
  "cash": {
   "currency": "Cash",
   "desc": "cash"
  },
  "eridium": {
   "currency": "eridium",
   "desc": "eridium"
  },
  "action_skill_cooldown": {
   "target": "cdo:GbxSkillComponentFunctions_ActionSkill",
   "func": "GetCooldownAsPercent",
   "args": {
    "target": "target:player.pawn"
   },
   "desc": "Action Skill cooldown, 0..1"
  },
  "skill_points_earned": {
   "points": "skill_points",
   "desc": "skill points earned (spent + unspent)"
  },
  "spec_tokens_earned": {
   "points": "spec_tokens",
   "desc": "specialization tokens earned"
  },
  "sdu_tokens_earned": {
   "points": "sdu_tokens",
   "desc": "SDU tokens earned (spent + unspent)"
  }
 },
 "actions": {
  "Engine.Version": {
   "target": "cdo:KismetSystemLibrary",
   "func": "GetEngineVersion",
   "write": false,
   "desc": "engine version string (smoke test for ProcessEvent)"
  },
  "Player.GodOn": {
   "target": "cdo:OakDamageStatics",
   "func": "SetGodLock",
   "args": {
    "OwnerContext": "target:player.pawn"
   },
   "after": "god",
   "desc": "god mode on (OakDamageStatics::SetGodLock)"
  },
  "Player.GodOff": {
   "target": "cdo:OakDamageStatics",
   "func": "UnSetGodLock",
   "args": {
    "OwnerContext": "target:player.pawn"
   },
   "after": "god",
   "desc": "god mode off"
  },
  "Player.AddOvershield": {
   "target": "cdo:OakInventoryStatics",
   "func": "AddOvershieldToOakCharacter",
   "args": {
    "TargetActor": "target:player.pawn",
    "Amount": "$v"
   },
   "arg": "Amount",
   "desc": "add overshield points (v = amount)"
  },
  "Currency.Give": {
   "target": "cdo:GbxCurrencyFunctionLibrary",
   "func": "GiveCurrency",
   "args": {
    "OwnerContext": "target:player.pc",
    "currency": "$v",
    "Amount": 1000
   },
   "arg": "currency",
   "desc": "give any currency through the game: v = def text, e.g. (\"Cash\",\"GbxCurrencyDef\"); args.Amount"
  },
  "Currency.AddCash": {
   "target": "cdo:GbxCurrencyFunctionLibrary",
   "func": "GiveCurrency",
   "args": {
    "OwnerContext": "target:player.pc",
    "currency": "def:(\"Cash\",\"GbxCurrencyDef\")",
    "Amount": "$v"
   },
   "arg": "Amount",
   "after": "cash",
   "desc": "add cash (v = amount)"
  },
  "Currency.AddEridium": {
   "target": "cdo:GbxCurrencyFunctionLibrary",
   "func": "GiveCurrency",
   "args": {
    "OwnerContext": "target:player.pc",
    "currency": "def:(\"eridium\",\"GbxCurrencyDef\")",
    "Amount": "$v"
   },
   "arg": "Amount",
   "after": "eridium",
   "desc": "add eridium (v = amount)"
  },
  "Loot.SpawnPool": {
   "target": "cdo:NexusConfigStoreItemPool",
   "func": "SpawnInventoryFromItemPool",
   "args": {
    "WorldContextObject": "target:player.pawn",
    "Transform": "$transform:position",
    "GameStage": 50,
    "ItemPoolName": "$v"
   },
   "arg": "ItemPoolName",
   "desc": "spawn loot from a named item pool at the player (dev store function). v = item pool name (itempool_*), args.GameStage = item level"
  },
  "Loot.DropPool": {
   "target": "cdo:ItemPoolFunctionLibrary",
   "func": "SpawnItemsFromItemPoolUsingActor_Drop",
   "args": {
    "SourceActor": "target:player.pawn",
    "itempool": "$v"
   },
   "arg": "itempool",
   "desc": "drop loot from a game item pool at the player (game's own loot roll). v = gdh:<pool name>, e.g. gdh:itempool_guns_tor (itempool_* / ItemPoolList_*)"
  },
  "Player.SetLevel": {
   "target": "player.ps",
   "func": "BP_SetExperienceLevel",
   "args": {
    "ExperienceDef": "def:(\"Character\",\"GbxExperienceDef\")",
    "ExperienceLevel": "$v"
   },
   "arg": "ExperienceLevel",
   "after": "level",
   "desc": "set character level (game's own BP_SetExperienceLevel; stats scale, skill points follow)"
  },
  "Player.SetSpecLevel": {
   "target": "player.ps",
   "func": "BP_SetExperienceLevel",
   "args": {
    "ExperienceDef": "def:(\"Specialization\",\"GbxExperienceDef\")",
    "ExperienceLevel": "$v"
   },
   "arg": "ExperienceLevel",
   "after": "spec_level",
   "desc": "set specialization level"
  },
  "Player.SetExperienceLevel": {
   "target": "player.ps",
   "func": "BP_SetExperienceLevel",
   "args": {
    "ExperienceDef": "$v",
    "ExperienceLevel": 1
   },
   "arg": "ExperienceDef",
   "desc": "any experience track: v = def text (\"VaultCard01_Experience\",\"GbxExperienceDef\"), args.ExperienceLevel"
  },
  "World.TimeScale": {
   "target": "cdo:GameplayStatics",
   "func": "SetGlobalTimeDilation",
   "args": {
    "WorldContextObject": "target:player.pawn",
    "TimeDilation": "$v"
   },
   "arg": "TimeDilation",
   "desc": "game speed (1 = normal, 0.3 = slow motion, 2 = fast)"
  },
  "Move.GroundSpeed": {
   "target": "player.comp:OakCharacterMovementComponent",
   "field": "MaxGroundSpeedScale",
   "arg": "v",
   "after": "ground_speed_scale",
   "desc": "ground speed multiplier (1 = normal)"
  },
  "Move.DashSpeed": {
   "target": "player.comp:OakCharacterMovementComponent",
   "field": "DashSpeed",
   "arg": "v",
   "desc": "dash speed"
  },
  "Move.GlideSpeed": {
   "target": "player.comp:OakCharacterMovementComponent",
   "field": "GlidingSpeed",
   "arg": "v",
   "desc": "glide speed"
  },
  "Move.FreeVaultPower": {
   "target": "player.comp:OakCharacterMovementComponent",
   "fields": [
    "VaultPowerCost_Dash",
    "VaultPowerCost_DoubleJump",
    "VaultPowerCost_Glide"
   ],
   "value": 0,
   "desc": "dash / double jump / glide cost no vault power"
  },
  "Move.Launch": {
   "target": "player.pawn",
   "func": "LaunchCharacter",
   "args": {
    "LaunchVelocity": {
     "Z": 1500
    },
    "bXYOverride": false,
    "bZOverride": true
   },
   "desc": "super jump (launch up)"
  },
  "Inventory.BackpackSize": {
   "target": "player.ps",
   "field": "BackpackContainer.MaxSize",
   "arg": "v",
   "desc": "backpack capacity (OakPlayerState.BackpackContainer.MaxSize, memory write - no game setter). Normal 16 + SDU upgrades. raise_only: never lowers a bigger size another mod set",
   "raise_only": true
  },
  "Inventory.BankSize": {
   "target": "player.ps",
   "field": "BankContainer.MaxSize",
   "arg": "v",
   "desc": "bank capacity (BankContainer.MaxSize, memory write). raise_only: never lowers a bigger size another mod set",
   "raise_only": true
  },
  "Player.Revive": {
   "target": "player.pawn",
   "func": "GoFromDeadToHealthy",
   "desc": "get up from Fight For Your Life / death"
  },
  "Weapon.RefillAmmo": {
   "target": "cdo:OakWeaponStatics",
   "func": "RefillAmmoForCurrentCharacterWeapon",
   "args": {
    "OwnerContext": "target:player.pawn",
    "Amount": 100,
    "bAsPercent": true
   },
   "desc": "refill ammo of the weapon in hand (100%)"
  },
  "Weapon.InfiniteAmmo": {
   "target": "player.pc",
   "field": "InfiniteAmmoLock.bLocked",
   "arg": "v",
   "desc": "the game's own infinite-ammo lock (OakPlayerController.InfiniteAmmoLock), v = 1 on / 0 off"
  },
  "Skill.RefillCooldown": {
   "target": "cdo:GbxSkillComponentFunctions_ActionSkill",
   "func": "RefillCooldown",
   "args": {
    "target": "target:player.pawn",
    "Percent": 1.0,
    "RefillMode": 0
   },
   "after": "action_skill_cooldown",
   "desc": "Action Skill ready again"
  },
  "Player.InvisibleOn": {
   "target": "cdo:GbxTeamFunctionLibrary",
   "func": "SetTeam",
   "args": {
    "AIActor": "target:player.pawn",
    "Team": "gdh:Team_FriendlyToAll:15"
   },
   "desc": "enemies ignore you: your character joins the game's Team_FriendlyToAll"
  },
  "Player.InvisibleOff": {
   "target": "cdo:GbxTeamFunctionLibrary",
   "func": "SetTeam",
   "args": {
    "AIActor": "target:player.pawn",
    "Team": "gdh:Team_Player:15"
   },
   "desc": "back on the player team"
  },
  "Skill.RefillDuration": {
   "target": "cdo:GbxSkillComponentFunctions_ActionSkill",
   "func": "RefillDuration",
   "args": {
    "target": "target:player.pawn",
    "Percent": 1.0,
    "RefillMode": 0
   },
   "desc": "Action Skill duration back to full"
  },
  "Skill.GetCooldown": {
   "target": "cdo:GbxSkillComponentFunctions_ActionSkill",
   "func": "GetCooldown",
   "args": {
    "target": "target:player.pawn"
   },
   "write": false,
   "desc": "Action Skill cooldown pool value"
  },
  "Skill.GetDuration": {
   "target": "cdo:GbxSkillComponentFunctions_ActionSkill",
   "func": "GetDuration",
   "args": {
    "target": "target:player.pawn"
   },
   "write": false,
   "desc": "Action Skill duration pool value"
  },
  "Skill.RefillCooldownByValue": {
   "target": "cdo:GbxSkillComponentFunctions_ActionSkill",
   "func": "RefillCooldownByValue",
   "args": {
    "target": "target:player.pawn"
   },
   "arg": "Value",
   "desc": "Add to the Action Skill cooldown pool"
  }
 },
